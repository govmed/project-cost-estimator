# Copy to .env.local and fill in values.
# Vite only exposes variables prefixed with VITE_ to the browser.

# standalone = Phase 1 localStorage mode (default)
# oidc       = Phase 2 Authentik mode
VITE_AUTH_MODE=standalone

# FastAPI backend URL (used in oidc mode)
VITE_API_BASE_URL=http://localhost:8000

# Authentik OIDC settings (required when VITE_AUTH_MODE=oidc)
# Get these from the Authentik admin UI after completing docs/authentik-setup.md
VITE_OIDC_AUTHORITY=http://localhost:9000/application/o/cost-estimator-api/
VITE_OIDC_CLIENT_ID=cost-estimator-spa
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
